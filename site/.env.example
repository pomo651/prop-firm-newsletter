# Supabase: blackout-clock project (ref fqgryxjuecjgelcjdvmq), schema funded_tape.
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://fqgryxjuecjgelcjdvmq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token the bots send to /api/bot/* (Authorization: Bearer <token>).
BOT_TOKEN=

# Opens draft editions: /daily?preview=<key> and /daily/<date>?preview=<key>.
PREVIEW_KEY=

# Owner key (pomo651 only): Publish / Unpublish / Approve Short buttons on a preview edition page.
OWNER_KEY=

# Daily auto-publish job (pg_cron -> /api/jobs/auto-publish sends this in x-job-secret).
FT_JOB_SECRET=

# Email for auto-publish results (Resend; onboarding sender only delivers to the Resend account owner).
RESEND_API_KEY=
NOTIFY_EMAIL=
